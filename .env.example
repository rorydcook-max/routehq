# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Organisation
NEXT_PUBLIC_DEFAULT_ORGANIZATION_SLUG=demo-fleet

# OpenAI
# Alerts on phones and computers (web push). Generate a pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com
OPENAI_API_KEY=sk-...
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_TRIM_CATALOG_MODEL=gpt-4o
OPENAI_CATALOG_RESEARCH_MODEL=gpt-4o

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# LINE Messaging API
LINE_CHANNEL_SECRET=your-line-channel-secret
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
LINE_OA_ID=@your-oa-id

# Cron protection — generate with: openssl rand -hex 32
CRON_SECRET=replace-with-a-random-secret

# App URL (used for internal API calls from webhook)
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Transactional email for executed rental documents. Leave empty until a provider
# is chosen - sends are then skipped and recorded, not failed. See lib/email/index.ts.
EMAIL_PROVIDER=
